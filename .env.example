# Optional WebSocket depth mode:
#   "full"     -> Free 5-level depth (works on all Upstox accounts + Analytics Token)
#   "full_d30" -> 30-level depth (requires paid Upstox Plus Pack)
UPSTOX_DEPTH_MODE=full
